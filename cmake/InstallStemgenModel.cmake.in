# This script runs during installation, after the staged model was verified at
# configure time. CMake has no descriptor-relative no-follow copy primitive,
# so the safe boundary is a fresh same-directory temporary file followed by an
# atomic rename. Revalidate every pathname before and after it is reopened.
function(_mixxx_stem_model_path_has_symlink_component input_path result_var)
  set(path_to_check "${input_path}")
  while(NOT path_to_check STREQUAL "")
    if(IS_SYMLINK "${path_to_check}")
      set(${result_var} TRUE PARENT_SCOPE)
      return()
    endif()
    get_filename_component(parent_path "${path_to_check}" DIRECTORY)
    if(parent_path STREQUAL path_to_check)
      break()
    endif()
    set(path_to_check "${parent_path}")
  endwhile()
  set(${result_var} FALSE PARENT_SCOPE)
endfunction()

function(
  _mixxx_stem_model_file_matches
  input_path
  expected_size
  expected_sha256
  result_var
)
  set(${result_var} FALSE PARENT_SCOPE)
  if(
    IS_SYMLINK "${input_path}"
    OR NOT EXISTS "${input_path}"
    OR IS_DIRECTORY "${input_path}"
  )
    return()
  endif()
  file(SIZE "${input_path}" actual_size)
  if(NOT actual_size EQUAL expected_size)
    return()
  endif()
  file(SHA256 "${input_path}" actual_sha256)
  if(NOT actual_sha256 STREQUAL expected_sha256)
    return()
  endif()
  set(${result_var} TRUE PARENT_SCOPE)
endfunction()

set(_mixxx_stem_model_path "@MIXXX_STEM_MODEL_STAGED_FILE@")
set(_mixxx_stem_model_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_path}"
  _mixxx_stem_model_path_has_symlink_component
)
if(_mixxx_stem_model_path_has_symlink_component)
  message(
    FATAL_ERROR
    "The staged Stemgen model path contains a symlink component: ${_mixxx_stem_model_path}"
  )
endif()

if(
  NOT EXISTS "${_mixxx_stem_model_path}"
  OR IS_DIRECTORY "${_mixxx_stem_model_path}"
)
  message(
    FATAL_ERROR
    "The staged Stemgen model is missing or is not a regular file: ${_mixxx_stem_model_path}"
  )
endif()

file(SIZE "${_mixxx_stem_model_path}" _mixxx_stem_model_size)
if(NOT _mixxx_stem_model_size EQUAL @MIXXX_STEM_MODEL_SIZE@)
  message(
    FATAL_ERROR
    "The staged Stemgen model size changed before install: ${_mixxx_stem_model_path}"
  )
endif()

file(SHA256 "${_mixxx_stem_model_path}" _mixxx_stem_model_sha256)
if(NOT _mixxx_stem_model_sha256 STREQUAL "@MIXXX_STEM_MODEL_SHA256@")
  message(
    FATAL_ERROR
    "The staged Stemgen model checksum changed before install: ${_mixxx_stem_model_path}"
  )
endif()

set(
  _mixxx_stem_model_destination_dir
  "${CMAKE_INSTALL_PREFIX}/@MIXXX_INSTALL_DATADIR@/models"
)
set(
  _mixxx_stem_model_destination_path
  "${_mixxx_stem_model_destination_dir}/@MIXXX_STEM_MODEL_NAME@"
)
set(_mixxx_stem_model_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_destination_path}"
  _mixxx_stem_model_path_has_symlink_component
)
if(_mixxx_stem_model_path_has_symlink_component)
  message(
    FATAL_ERROR
    "The installed Stemgen model path contains a symlink component: ${_mixxx_stem_model_destination_path}"
  )
endif()

file(MAKE_DIRECTORY "${_mixxx_stem_model_destination_dir}")

# MAKE_DIRECTORY reopens the destination parent chain. Revalidate it after
# creation so a replacement that happened while creating missing components is
# rejected before the temporary copy can follow it.
set(_mixxx_stem_model_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_destination_path}"
  _mixxx_stem_model_path_has_symlink_component
)
if(_mixxx_stem_model_path_has_symlink_component)
  message(
    FATAL_ERROR
    "The installed Stemgen model path gained a symlink component while creating its parent: ${_mixxx_stem_model_destination_path}"
  )
endif()

# Do not copy directly to the destination: COPY_FILE would truncate a raced
# hard link. A rename replaces the directory entry instead, leaving any other
# hard link to the old artifact untouched. Refuse a temporary-name collision
# rather than allowing COPY_FILE to reopen an attacker-controlled pathname.
string(RANDOM LENGTH 32 ALPHABET "0123456789abcdef" _mixxx_stem_model_nonce)
set(
  _mixxx_stem_model_temporary_path
  "${_mixxx_stem_model_destination_dir}/.@MIXXX_STEM_MODEL_NAME@.${_mixxx_stem_model_nonce}.tmp"
)
if(
  EXISTS "${_mixxx_stem_model_temporary_path}"
  OR IS_SYMLINK "${_mixxx_stem_model_temporary_path}"
)
  message(
    FATAL_ERROR
    "The temporary Stemgen model destination already exists: ${_mixxx_stem_model_temporary_path}"
  )
endif()
file(
  COPY_FILE
  "${_mixxx_stem_model_path}"
  "${_mixxx_stem_model_temporary_path}"
  RESULT _mixxx_stem_model_copy_result
)
if(NOT _mixxx_stem_model_copy_result STREQUAL "0")
  file(REMOVE "${_mixxx_stem_model_temporary_path}")
  message(
    FATAL_ERROR
    "Could not stage the Stemgen model for installation: ${_mixxx_stem_model_copy_result}"
  )
endif()

set(_mixxx_stem_model_temporary_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_temporary_path}"
  _mixxx_stem_model_temporary_path_has_symlink_component
)
set(_mixxx_stem_model_temporary_matches FALSE)
if(NOT _mixxx_stem_model_temporary_path_has_symlink_component)
  _mixxx_stem_model_file_matches(
    "${_mixxx_stem_model_temporary_path}"
    @MIXXX_STEM_MODEL_SIZE@
    "@MIXXX_STEM_MODEL_SHA256@"
    _mixxx_stem_model_temporary_matches
  )
endif()
if(NOT _mixxx_stem_model_temporary_matches)
  file(REMOVE "${_mixxx_stem_model_temporary_path}")
  message(
    FATAL_ERROR
    "The temporary Stemgen model did not match the verified model: ${_mixxx_stem_model_temporary_path}"
  )
endif()

# Revalidate immediately before the pathname-based rename. The checks cannot
# close the final scheduling window on platforms where CMake exposes no fd-
# level operation, but they make the boundary explicit and fail closed for
# every replacement observed before or after the atomic operation.
set(_mixxx_stem_model_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_destination_path}"
  _mixxx_stem_model_path_has_symlink_component
)
if(_mixxx_stem_model_path_has_symlink_component)
  file(REMOVE "${_mixxx_stem_model_temporary_path}")
  message(
    FATAL_ERROR
    "The installed Stemgen model path gained a symlink component before publication: ${_mixxx_stem_model_destination_path}"
  )
endif()
if(IS_SYMLINK "${_mixxx_stem_model_destination_path}")
  file(REMOVE "${_mixxx_stem_model_temporary_path}")
  message(
    FATAL_ERROR
    "The installed Stemgen model destination must not be a symlink: ${_mixxx_stem_model_destination_path}"
  )
endif()
if(IS_DIRECTORY "${_mixxx_stem_model_destination_path}")
  file(REMOVE "${_mixxx_stem_model_temporary_path}")
  message(
    FATAL_ERROR
    "The installed Stemgen model destination is a directory: ${_mixxx_stem_model_destination_path}"
  )
endif()

set(_mixxx_stem_model_backup_path "")
if(EXISTS "${_mixxx_stem_model_destination_path}")
  string(RANDOM LENGTH 32 ALPHABET "0123456789abcdef" _mixxx_stem_model_backup_nonce)
  set(
    _mixxx_stem_model_backup_path
    "${_mixxx_stem_model_destination_path}.backup.${_mixxx_stem_model_backup_nonce}"
  )
  if(
    EXISTS "${_mixxx_stem_model_backup_path}"
    OR IS_SYMLINK "${_mixxx_stem_model_backup_path}"
  )
    file(REMOVE "${_mixxx_stem_model_temporary_path}")
    message(
      FATAL_ERROR
      "The Stemgen model rollback destination already exists: ${_mixxx_stem_model_backup_path}"
    )
  endif()
  file(
    RENAME
    "${_mixxx_stem_model_destination_path}"
    "${_mixxx_stem_model_backup_path}"
    RESULT _mixxx_stem_model_backup_result
  )
  if(NOT _mixxx_stem_model_backup_result STREQUAL "0")
    file(REMOVE "${_mixxx_stem_model_temporary_path}")
    message(
      FATAL_ERROR
      "Could not preserve the existing Stemgen model for rollback: ${_mixxx_stem_model_backup_result}"
    )
  endif()
endif()

file(
  RENAME
  "${_mixxx_stem_model_temporary_path}"
  "${_mixxx_stem_model_destination_path}"
  RESULT _mixxx_stem_model_rename_result
)
if(NOT _mixxx_stem_model_rename_result STREQUAL "0")
  if(_mixxx_stem_model_backup_path)
    if(
      NOT EXISTS "${_mixxx_stem_model_destination_path}"
      AND NOT IS_SYMLINK "${_mixxx_stem_model_destination_path}"
    )
      file(
        RENAME
        "${_mixxx_stem_model_backup_path}"
        "${_mixxx_stem_model_destination_path}"
        RESULT _mixxx_stem_model_restore_result
      )
      if(_mixxx_stem_model_restore_result STREQUAL "0")
        set(_mixxx_stem_model_backup_path "")
      endif()
    endif()
  endif()
  file(REMOVE "${_mixxx_stem_model_temporary_path}")
  message(
    FATAL_ERROR
    "Could not publish the Stemgen model atomically: ${_mixxx_stem_model_rename_result}"
  )
endif()

set(_mixxx_stem_model_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_path}"
  _mixxx_stem_model_path_has_symlink_component
)
if(_mixxx_stem_model_path_has_symlink_component)
  message(
    FATAL_ERROR
    "The staged Stemgen model path gained a symlink component during install: ${_mixxx_stem_model_path}"
  )
endif()

set(_mixxx_stem_model_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_destination_path}"
  _mixxx_stem_model_path_has_symlink_component
)
if(_mixxx_stem_model_path_has_symlink_component)
  message(
    FATAL_ERROR
    "The installed Stemgen model path gained a symlink component during install: ${_mixxx_stem_model_destination_path}"
  )
endif()

set(_mixxx_stem_model_destination_matches FALSE)
set(_mixxx_stem_model_destination_path_has_symlink_component FALSE)
_mixxx_stem_model_path_has_symlink_component(
  "${_mixxx_stem_model_destination_path}"
  _mixxx_stem_model_destination_path_has_symlink_component
)
if(NOT _mixxx_stem_model_destination_path_has_symlink_component)
  _mixxx_stem_model_file_matches(
    "${_mixxx_stem_model_destination_path}"
    @MIXXX_STEM_MODEL_SIZE@
    "@MIXXX_STEM_MODEL_SHA256@"
    _mixxx_stem_model_destination_matches
  )
endif()
if(NOT _mixxx_stem_model_destination_matches)
  # Only remove the new entry when it still contains the verified bytes. If a
  # competing process changed the path, leave it untouched and retain the
  # rollback copy so this script never removes an unowned artifact.
  set(_mixxx_stem_model_rollback_destination_matches FALSE)
  if(NOT _mixxx_stem_model_destination_path_has_symlink_component)
    _mixxx_stem_model_file_matches(
      "${_mixxx_stem_model_destination_path}"
      @MIXXX_STEM_MODEL_SIZE@
      "@MIXXX_STEM_MODEL_SHA256@"
      _mixxx_stem_model_rollback_destination_matches
    )
  endif()
  if(_mixxx_stem_model_rollback_destination_matches)
    file(REMOVE "${_mixxx_stem_model_destination_path}")
  endif()
  if(_mixxx_stem_model_backup_path)
    if(
      NOT EXISTS "${_mixxx_stem_model_destination_path}"
      AND NOT IS_SYMLINK "${_mixxx_stem_model_destination_path}"
    )
      file(
        RENAME
        "${_mixxx_stem_model_backup_path}"
        "${_mixxx_stem_model_destination_path}"
        RESULT _mixxx_stem_model_rollback_result
      )
      if(_mixxx_stem_model_rollback_result STREQUAL "0")
        set(_mixxx_stem_model_backup_path "")
      endif()
    endif()
  endif()
  message(
    FATAL_ERROR
    "The installed Stemgen model failed post-publication verification: ${_mixxx_stem_model_destination_path}"
  )
endif()

if(_mixxx_stem_model_backup_path)
  file(REMOVE "${_mixxx_stem_model_backup_path}")
endif()
