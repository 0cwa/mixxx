# Runtime dependency installation is failure-safe only through the native
# user-local wrapper, which supplies a disposable staging prefix.

if(NOT "$ENV{MIXXX_LOCALUSER_INSTALL_STAGING}" STREQUAL "1")
  message(
    FATAL_ERROR
    "MIXXX_INSTALL_RUNTIME_DEPENDENCIES requires tools/localuser-install.sh staging"
  )
endif()

if(NOT CMAKE_INSTALL_PREFIX MATCHES "/\\.mixxx-install\\.[A-Za-z0-9]+$")
  message(
    FATAL_ERROR
    "MIXXX_INSTALL_RUNTIME_DEPENDENCIES requires a disposable staging prefix"
  )
endif()
